<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel - @ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- TODO (Phase 3): admin panel styling pass -->
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Admin/News">DailyNews Admin Panel</a>
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="News" asp-action="Index">News</a></li>
            </ul>
            <a class="nav-link text-white" href="/">Back to site</a>
        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>
