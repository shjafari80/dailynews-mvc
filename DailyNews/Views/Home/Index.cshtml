@model IEnumerable<DailyNews.Models.News>

@{
    ViewData["Title"] = "Home";
}

<h1 class="mb-4">DailyNews</h1>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@item.Title</h5>
                    <p class="card-text text-muted small">
                        @item.Category.Name &bull; by @item.Author.Name &bull; @item.PublishDate.ToString("dd MMM yyyy")
                    </p>
                    <p class="card-text">
                        @(item.Content.Length > 150 ? item.Content.Substring(0, 150) + "..." : item.Content)
                    </p>
                </div>
                <div class="card-footer">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Read More</a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <p class="text-muted text-center mt-4">No articles yet.</p>
}
