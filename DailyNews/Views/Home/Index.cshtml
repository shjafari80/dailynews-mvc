@model IEnumerable<DailyNews.Models.News>

@{
    ViewData["Title"] = "Home";

    string BadgeClass(string category) => category switch
    {
        "Politics" => "badge-category badge-politics",
        "Economy" => "badge-category badge-economy",
        "Sports" => "badge-category badge-sports",
        "Culture" => "badge-category badge-culture",
        _ => "badge-category"
    };

    var searchQuery = ViewData["SearchQuery"] as string;
    var isSearching = !string.IsNullOrWhiteSpace(searchQuery);
    var newsList = Model.ToList();

    const int carouselSize = 4;
    var carouselItems = isSearching ? new List<DailyNews.Models.News>() : newsList.Take(carouselSize).ToList();
    var rest = isSearching ? newsList : newsList.Skip(carouselItems.Count).ToList();
}

@if (isSearching)
{
    <p class="text-muted mb-4">
        Showing results for "<strong>@searchQuery</strong>"
        &mdash; <a asp-action="Index">clear search</a>
    </p>
}

@if (carouselItems.Any())
{
    <div id="heroCarousel" class="carousel slide carousel-dark hero-carousel mb-5" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (int i = 0; i < carouselItems.Count; i++)
            {
                var item = carouselItems[i];
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <div class="img-wrap img-wrap-hero mb-3">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Title" />
                        }
                        else
                        {
                            <div class="img-placeholder"><span>DailyNews</span></div>
                        }
                    </div>
                    <span class="@BadgeClass(item.Category.Name)">@item.Category.Name</span>
                    <h1 class="hero-title mt-2">
                        <a asp-action="Details" asp-route-id="@item.Id">@item.Title</a>
                    </h1>
                    <p class="text-muted small mb-2">
                        by @item.Author.Name &bull; @item.PublishDate.ToString("dd MMM yyyy")
                    </p>
                    <p class="hero-excerpt">
                        @(item.Content.Length > 280 ? item.Content.Substring(0, 280) + "..." : item.Content)
                    </p>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-dark">Read Full Story</a>
                </div>
            }
        </div>

        <div class="carousel-indicators">
            @for (int i = 0; i < carouselItems.Count; i++)
            {
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i"
                        class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")"
                        aria-label="Slide @(i + 1)"></button>
            }
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
}

@if (rest.Any())
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in rest)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="img-wrap img-wrap-card">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Title" />
                        }
                        else
                        {
                            <div class="img-placeholder"><span>DN</span></div>
                        }
                    </div>
                    <div class="card-body">
                        <span class="@BadgeClass(item.Category.Name)">@item.Category.Name</span>
                        <h5 class="card-title mt-2">@item.Title</h5>
                        <p class="card-text text-muted small">
                            by @item.Author.Name &bull; @item.PublishDate.ToString("dd MMM yyyy")
                        </p>
                        <p class="card-text">
                            @(item.Content.Length > 150 ? item.Content.Substring(0, 150) + "..." : item.Content)
                        </p>
                    </div>
                    <div class="card-footer">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark btn-sm">Read More</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (!newsList.Any() && isSearching)
{
    <p class="text-muted text-center mt-4">No articles match "@searchQuery".</p>
}
else if (!newsList.Any())
{
    <p class="text-muted text-center mt-4">No articles yet.</p>
}
