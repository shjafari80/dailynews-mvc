@model DailyNews.Models.News

@{
    ViewData["Title"] = Model.Title;

    string BadgeClass(string category) => category switch
    {
        "Politics" => "badge-category badge-politics",
        "Economy" => "badge-category badge-economy",
        "Sports" => "badge-category badge-sports",
        "Culture" => "badge-category badge-culture",
        _ => "badge-category"
    };

    var related = ViewData["RelatedArticles"] as List<DailyNews.Models.News> ?? new List<DailyNews.Models.News>();

    var wordCount = Model.Content.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;
    var readingMinutes = Math.Max(1, (int)Math.Ceiling(wordCount / 200.0));
}

<span class="@BadgeClass(Model.Category.Name)">@Model.Category.Name</span>
<h1 class="mt-2 mb-3">@Model.Title</h1>

<div class="text-muted mb-4">
    <span>by @Model.Author.Name</span> &bull;
    <span>@Model.PublishDate.ToString("dd MMMM yyyy - HH:mm")</span> &bull;
    <span>~@readingMinutes min read</span>
</div>

<div class="lead">
    @Model.Content
</div>

<a asp-action="Index" class="btn btn-outline-dark mt-4">Back to Home</a>

@if (related.Any())
{
    <hr class="my-5" />
    <h3 class="mb-4">Related in @Model.Category.Name</h3>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in related)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <span class="@BadgeClass(item.Category.Name)">@item.Category.Name</span>
                        <h5 class="card-title mt-2">@item.Title</h5>
                        <p class="card-text text-muted small">
                            by @item.Author.Name &bull; @item.PublishDate.ToString("dd MMM yyyy")
                        </p>
                    </div>
                    <div class="card-footer">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark btn-sm">Read More</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
