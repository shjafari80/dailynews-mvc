@model DailyNews.Models.News

@{
    ViewData["Title"] = Model.Title;

    string BadgeClass(string category) => category switch
    {
        "Politics" => "badge-category badge-politics",
        "Economy" => "badge-category badge-economy",
        "Sports" => "badge-category badge-sports",
        "Culture" => "badge-category badge-culture",
        _ => "badge-category"
    };
}

<span class="@BadgeClass(Model.Category.Name)">@Model.Category.Name</span>
<h1 class="mt-2 mb-3">@Model.Title</h1>

<div class="text-muted mb-4">
    <span>by @Model.Author.Name</span> &bull;
    <span>@Model.PublishDate.ToString("dd MMMM yyyy - HH:mm")</span>
</div>

<div class="lead">
    @Model.Content
</div>

<a asp-action="Index" class="btn btn-outline-dark mt-4">Back to Home</a>
