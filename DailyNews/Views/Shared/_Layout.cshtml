<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DailyNews</title>

    @{
        var metaDescription = ViewData["MetaDescription"] as string
            ?? "DailyNews - the latest political, economic, sports, and cultural news.";
        var metaImage = ViewData["MetaImage"] as string;
    }
    <meta name="description" content="@metaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DailyNews" />
    <meta property="og:title" content="@ViewData["Title"] - DailyNews" />
    <meta property="og:description" content="@metaDescription" />
    @if (!string.IsNullOrEmpty(metaImage))
    {
        <meta property="og:image" content="@metaImage" />
    }

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="masthead">
        <div class="container text-center">
            <div class="masthead-date">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
            <a class="masthead-title" asp-controller="Home" asp-action="Index">DailyNews</a>
        </div>
        <div class="masthead-rule"></div>
        <nav class="navbar navbar-expand-lg">
            <div class="container position-relative justify-content-center">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Authors" asp-action="Index">Authors</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About Us</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                </ul>
                <form class="search-form search-form-desktop position-absolute end-0 top-50 translate-middle-y" asp-controller="Home" asp-action="Index" method="get">
                    <input type="search" name="query" class="form-control form-control-sm" placeholder="Search articles..." value="@ViewData["SearchQuery"]" />
                </form>
            </div>
        </nav>
        <div class="container">
            <form class="search-form search-form-mobile" asp-controller="Home" asp-action="Index" method="get">
                <input type="search" name="query" class="form-control form-control-sm" placeholder="Search articles..." value="@ViewData["SearchQuery"]" />
            </form>
        </div>
    </header>

    <main role="main" class="container my-4">
        @RenderBody()
    </main>

    <footer class="text-center py-3">
        <div class="container">
            <p class="mb-0">&copy; 2026 - DailyNews</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
